{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AVEditor",
  "mainBinaryName": "MediaCuter-v0.1.0",
  "version": "0.1.0",
  "identifier": "com.zhch.tauri01",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "音视频剪辑工具",
        "width": 896,
        "height": 630,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
